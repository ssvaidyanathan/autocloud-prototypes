# Google Cloud Platform project
GCP_PROJECT=your-gcp-project-id

# Vertex AI Location
VERTEX_AI_LOCATION=us-central1

# Bridge Callback URL
BRIDGE_SERVICE_URL=http://localhost:8080/callback/report
