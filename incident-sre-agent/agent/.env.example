# SRE Agent Service Configuration
# Copy this file to .env and fill in the required values for your environment.

# Server Configuration
PORT=8080

# Google Cloud Platform Configuration
GCP_PROJECT=your-project-id
GCP_REGION=us-central1
VERTEX_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Model Names (Defaults to latest GA Gemini 3.8 on global Vertex endpoint)
MODEL_DISPATCHER=gemini-3.8-flash
MODEL_SPECIALIST=gemini-3.8-flash
MODEL_SYNTHESIZER=gemini-3.8-flash

# Model Aliases (Optional overrides)
GEMINI_PRO_MODEL=gemini-3.8-flash
GEMINI_FLASH_MODEL=gemini-3.8-flash

# Environment and Service Identification
APP_ENV=production
NAME_PREFIX=isa
SERVICE_NAME=sre-agent

# Security & Callback Allowlist (comma-separated or wildcard)
ALLOWED_CALLBACK_HOSTS=*.run.app,localhost

# Execution Budgets & Timeouts
TIMEOUT_SECONDS=600
INVESTIGATION_TIMEOUT_SECONDS=300
INVESTIGATION_BUDGET_SECONDS=300.0
MAX_REVIEW_ROUNDS=1

# Specialist Execution Limits
SPECIALIST_QUERY_LIMIT=5
SPECIALIST_MAX_ENTRIES=50
SPECIALIST_MAX_LLM_CALLS=8
SPECIALIST_MAX_TOOL_CALLS=5
MAX_TOOL_CALLS_PER_SPECIALIST=25
DEFAULT_LOOKBACK_MINUTES=60
MAX_QUERY_WINDOW_HOURS=24

# Callback HTTP Client & Retry Configuration
CALLBACK_CONNECT_TIMEOUT_SECONDS=5.0
CALLBACK_READ_TIMEOUT_SECONDS=45.0
CALLBACK_MAX_RETRIES=3
CALLBACK_BACKOFF_FACTOR=1.5
