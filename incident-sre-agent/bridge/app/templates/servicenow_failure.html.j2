<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; line-height: 1.5; color: #202124; border-left: 4px solid #d93025; padding: 12px 16px; background-color: #f8f9fa; border-radius: 4px;">
  <h1 style="color: #d93025; font-size: 18px; margin: 0 0 8px 0; font-weight: 600;">{{ title }}</h1>
  <h2 style="color: #202124; font-size: 15px; margin: 0 0 6px 0; font-weight: 600;">{{ subtitle }}</h2>
  <div style="background: #fce8e6; border-left: 4px solid #d93025; padding: 6px 10px; margin: 8px 0; border-radius: 3px; color: #c5221f;">
    {{ message }}
  </div>
</div>
