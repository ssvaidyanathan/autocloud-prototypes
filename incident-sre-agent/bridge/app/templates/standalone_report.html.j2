<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SRE Investigation Report - {{ incident_ref.external_key if incident_ref else 'Incident' }}</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 24px;
      background-color: #f8f9fa;
      color: #202124;
      line-height: 1.6;
    }
    .container {
      max-width: 960px;
      margin: 0 auto;
      background: #ffffff;
      padding: 32px;
      border-radius: 8px;
      box-shadow: 0 1px 3px rgba(60,64,67,0.3);
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid #1a73e8;
      padding-bottom: 16px;
      margin-bottom: 24px;
    }
    .header h1 {
      margin: 0;
      color: #1a73e8;
      font-size: 24px;
    }
    .badge {
      background: #e8f0fe;
      color: #1a73e8;
      padding: 4px 12px;
      border-radius: 16px;
      font-weight: 600;
      font-size: 13px;
    }
    .section {
      margin-bottom: 28px;
    }
    .section-title {
      font-size: 18px;
      font-weight: 600;
      color: #202124;
      border-bottom: 1px solid #dadce0;
      padding-bottom: 6px;
      margin-bottom: 12px;
    }
    .root-cause-box {
      background-color: #fef7e0;
      border-left: 4px solid #f9ab00;
      padding: 16px;
      border-radius: 4px;
      margin-bottom: 20px;
    }
    .root-cause-title {
      font-weight: 700;
      color: #b06000;
      margin-bottom: 6px;
      font-size: 15px;
    }
    .caveats-box {
      background-color: #fce8e6;
      border-left: 4px solid #d93025;
      padding: 16px;
      border-radius: 4px;
      margin-bottom: 20px;
    }
    .caveats-title {
      font-weight: 700;
      color: #c5221f;
      margin-bottom: 6px;
      font-size: 15px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
      margin-bottom: 16px;
      font-size: 13px;
    }
    th, td {
      padding: 10px 12px;
      border: 1px solid #dadce0;
      text-align: left;
    }
    th {
      background-color: #f1f3f4;
      font-weight: 600;
    }
    pre {
      background: #f8f9fa;
      padding: 8px;
      border-radius: 4px;
      font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 12px;
      overflow-x: auto;
      margin: 0;
      white-space: pre-wrap;
      word-break: break-all;
    }
    .action-list {
      padding-left: 20px;
      margin: 0;
    }
    .action-list li {
      margin-bottom: 6px;
    }
    .footer {
      margin-top: 32px;
      padding-top: 16px;
      border-top: 1px solid #dadce0;
      font-size: 12px;
      color: #5f6368;
      display: flex;
      justify-content: space-between;
    }
    a {
      color: #1a73e8;
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div>
        <h1>SRE Investigation Report</h1>
        {% if incident_ref %}
        <div style="font-size: 14px; color: #5f6368; margin-top: 4px;">
          Incident: <strong>{{ incident_ref.external_key }}</strong> (Source: {{ incident_ref.source }})
        </div>
        {% endif %}
      </div>
      <span class="badge">Google Cloud SRE Agent</span>
    </div>

    <div class="section">
      <div class="section-title">Summary & Impact</div>
      <p><strong>Executive Summary:</strong> {{ report.summary }}</p>
      <p><strong>Impact Assessment:</strong> {{ report.impact }}</p>
    </div>

    {% if report.probable_root_cause %}
    <div class="root-cause-box">
      <div class="root-cause-title">
        Probable Root Cause (Confidence: {{ (report.probable_root_cause.confidence * 100)|round|int }}%)
      </div>
      <div>{{ report.probable_root_cause.text }}</div>
    </div>
    {% endif %}

    {% if report.caveats %}
    <div class="caveats-box">
      <div class="caveats-title">
        Investigation Caveats &amp; Telemetry Limitations
      </div>
      <ul style="padding-left: 20px; margin: 0; color: #202124;">
        {% for caveat in report.caveats %}
        <li style="margin-bottom: 4px;">{{ caveat }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if report.recommended_actions %}
    <div class="section">
      <div class="section-title">Recommended Actions</div>
      <ol class="action-list">
        {% for action in report.recommended_actions %}
        <li>{{ action }}</li>
        {% endfor %}
      </ol>
    </div>
    {% endif %}

    {% if report.timeline %}
    <div class="section">
      <div class="section-title">Chronological Timeline</div>
      <table>
        <thead>
          <tr>
            <th style="width: 25%;">Timestamp (UTC)</th>
            <th>Event Description</th>
          </tr>
        </thead>
        <tbody>
          {% for item in report.timeline %}
          <tr>
            <td style="font-family: monospace;">{{ item.timestamp.isoformat() }}</td>
            <td>{{ item.description }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {% if report.evidence_by_area %}
    <div class="section">
      <div class="section-title">Telemetry & Specialist Evidence</div>
      {% for area, items in report.evidence_by_area.items() %}
      <h3 style="font-size: 14px; text-transform: uppercase; color: #5f6368; margin: 16px 0 8px 0;">{{ area }} Evidence</h3>
      <table>
        <thead>
          <tr>
            <th style="width: 15%;">Kind</th>
            <th>Evidence Excerpt</th>
            <th style="width: 15%; text-align: center;">Console Link</th>
          </tr>
        </thead>
        <tbody>
          {% for item in items %}
          <tr>
            <td>{{ item.kind }}</td>
            <td><pre><code>{{ item.excerpt }}</code></pre></td>
            <td style="text-align: center;">
              {% if item.console_url %}
              <a href="{{ item.console_url }}" target="_blank">Cloud Console</a>
              {% else %}
              -
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endfor %}
    </div>
    {% endif %}

    {% if report.recent_changes %}
    <div class="section">
      <div class="section-title">Recent Changes & Deployments</div>
      <table>
        <thead>
          <tr>
            <th style="width: 25%;">Timestamp (UTC)</th>
            <th>Change Description</th>
            <th style="width: 20%;">Author</th>
          </tr>
        </thead>
        <tbody>
          {% for change in report.recent_changes %}
          <tr>
            <td style="font-family: monospace;">{{ change.timestamp.isoformat() }}</td>
            <td>{{ change.description }}</td>
            <td>{{ change.author or 'System' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {% if report.specialists_status %}
    <div class="section">
      <div class="section-title">Investigation Coverage</div>
      <table>
        <thead>
          <tr>
            <th>Specialist Area</th>
            <th>Status</th>
            <th>Error / Diagnostic</th>
          </tr>
        </thead>
        <tbody>
          {% for s in report.specialists_status %}
          <tr>
            <td><strong>{{ s.specialist }}</strong></td>
            <td>
              {% if s.status == 'completed' %}<span style="color: #188038; font-weight: 600;">Completed</span>
              {% elif s.status == 'failed' %}<span style="color: #d93025; font-weight: 600;">Failed</span>
              {% else %}<span style="color: #80868b;">Skipped</span>{% endif %}
            </td>
            <td>{{ s.error or '-' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {% if report.queries_appendix %}
    <div class="section">
      <div class="section-title">Queries Run Appendix</div>
      {% for specialist, queries in report.queries_appendix.items() %}
      <div style="font-weight: 600; font-size: 13px; margin: 8px 0;">{{ specialist }}</div>
      <ul>
        {% for q in queries %}
        <li><code style="font-size: 12px; background: #f1f3f4; padding: 2px 4px; border-radius: 2px;">{{ q }}</code></li>
        {% endfor %}
      </ul>
      {% endfor %}
    </div>
    {% endif %}

    <div class="footer">
      <div>Generated automatically by Incident SRE Agent</div>
      <div>Skills used: {{ report.skills_used|join(', ') if report.skills_used else 'standard' }}</div>
    </div>
  </div>
</body>
</html>
