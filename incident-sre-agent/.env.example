# Incident SRE Agent System Configuration
# Copy this file to .env in local development or root orchestration.

# Resource Naming Prefix (e.g. isa, acme)
NAME_PREFIX=isa

# Server & Environment Configuration
PORT=8080
APP_ENV=production
ENVIRONMENT=production

# Google Cloud Platform Configuration
GCP_PROJECT=your-project-id
GCP_REGION=us-central1
VERTEX_LOCATION=global

# Cloud Tasks Queue Configuration
TASKS_QUEUE=isa-investigations
TASKS_LOCATION=us-central1
TASKS_INVOKER_SA=isa-tasks-invoker-sa@your-project-id.iam.gserviceaccount.com

# Service URLs & Identity
AGENT_SERVICE_URL=https://isa-sre-agent-xyz-uc.a.run.app
AGENT_SA=isa-agent-sa@your-project-id.iam.gserviceaccount.com
CALLBACK_URL=https://isa-incident-bridge-xyz-uc.a.run.app/callback

# Gemini Model Configuration
MODEL_DISPATCHER=gemini-3.8-flash
MODEL_SPECIALIST=gemini-3.8-flash
MODEL_SYNTHESIZER=gemini-3.8-flash

# Ticketing Credentials (optional)
# SERVICENOW_INSTANCE_URL=https://example.service-now.com
# SERVICENOW_USERNAME=svc_sre_agent
# SERVICENOW_PASSWORD=example_password
# SERVICENOW_WEBHOOK_TOKEN=example_token
# JIRA_BASE_URL=https://example.atlassian.net
# JIRA_EMAIL=sre-agent@example.com
# JIRA_API_TOKEN=example_token
# JIRA_WEBHOOK_TOKEN=example_token
# GENERIC_HMAC_KEY=example_hmac_key
