# Incident Bridge Service Configuration
# Copy this file to .env and fill in the required values for your environment.

# Server Configuration
PORT=8080
APP_ENV=production
ENVIRONMENT=production
NAME_PREFIX=isa
SERVICE_NAME=incident-bridge

# Google Cloud Platform Configuration
GCP_PROJECT=your-project-id
GCP_REGION=us-central1

# Cloud Tasks Queue Configuration
TASKS_QUEUE=investigations
TASKS_LOCATION=us-central1
TASKS_INVOKER_SA=tasks-invoker-sa@your-project-id.iam.gserviceaccount.com

# SRE Agent Service Configuration
AGENT_SERVICE_URL=https://sre-agent-xyz-uc.a.run.app
AGENT_SA=agent-sa@your-project-id.iam.gserviceaccount.com

# Callback URL for Agent to Post Results
CALLBACK_URL=https://incident-bridge-xyz-uc.a.run.app/callback

# Adapter Performance & Chunking
ADAPTER_TIMEOUT_SECONDS=30.0
SERVICENOW_CHUNK_SIZE=12000
JIRA_CHUNK_SIZE=32000

# ServiceNow Integration (optional)
SERVICENOW_INSTANCE_URL=https://example-instance.service-now.com
SERVICENOW_USERNAME=svc_sre_agent
SERVICENOW_PASSWORD=example_servicenow_password
SERVICENOW_WEBHOOK_TOKEN=example_servicenow_webhook_token
SERVICENOW_IN_PROGRESS_STATE=2

# Jira Integration (optional)
JIRA_BASE_URL=https://example.atlassian.net
JIRA_EMAIL=sre-agent@example.com
JIRA_API_TOKEN=example_jira_api_token
JIRA_WEBHOOK_TOKEN=example_jira_webhook_token
JIRA_IN_PROGRESS_TRANSITION=In Progress

# Generic Webhook Integration (optional)
GENERIC_HMAC_KEY=example_generic_hmac_key_hex

# HITL & Template Configuration (optional)
TICKET_TEMPLATE_PATH=
HITL_CALLER_SA=hitl-chatbot-sa@your-project-id.iam.gserviceaccount.com
