{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GetRecentDeploymentsRequest",
  "description": "Request schema for get_recent_deployments tool",
  "type": "object",
  "properties": {
    "workload": {
      "type": "string",
      "description": "Target workload name"
    },
    "workload_name": {
      "type": "string",
      "description": "Alias for workload"
    },
    "cluster": {
      "type": "string",
      "description": "Cluster identifier"
    },
    "cluster_name": {
      "type": "string",
      "description": "Alias for cluster"
    },
    "namespace": {
      "type": "string",
      "description": "Kubernetes namespace"
    },
    "start_time": {
      "type": "string",
      "description": "ISO-8601 start timestamp filter"
    },
    "end_time": {
      "type": "string",
      "description": "ISO-8601 end timestamp filter"
    },
    "limit": {
      "type": "integer",
      "description": "Maximum number of deployment events to return (default: 5, max: 20)",
      "default": 5,
      "minimum": 1,
      "maximum": 20
    }
  },
  "additionalProperties": false
}
