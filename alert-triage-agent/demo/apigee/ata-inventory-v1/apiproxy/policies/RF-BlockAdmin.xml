<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-BlockAdmin">
    <DisplayName>Block Admin Endpoints</DisplayName>
    <FaultResponse>
        <Set>
            <Payload contentType="application/json">{"error": "Forbidden: Administrative access restricted"}</Payload>
            <StatusCode>403</StatusCode>
            <ReasonPhrase>Forbidden</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
