<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <Description>Default proxy endpoint for ata-inventory-v1</Description>
    <FaultRules/>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>RF-BlockAdmin</Name>
                <Condition>proxy.pathsuffix MatchesPath "/admin/**" or proxy.pathsuffix MatchesPath "/admin/*" or proxy.pathsuffix ~~ "/admin.*"</Condition>
            </Step>
            <Step>
                <Name>VA-VerifyKey-Header</Name>
                <Condition>proxy.pathsuffix != "/health" and request.header.x-api-key != null</Condition>
            </Step>
            <Step>
                <Name>VA-VerifyKey-Query</Name>
                <Condition>proxy.pathsuffix != "/health" and request.header.x-api-key == null</Condition>
            </Step>
            <Step>
                <Name>SA-SpikeArrest</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <PostClientFlow>
        <Request/>
        <Response>
            <Step>
                <Name>ML-CloudLogging</Name>
            </Step>
        </Response>
    </PostClientFlow>
    <Flows/>
    <HTTPProxyConnection>
        <BasePath>/ata/inventory/v1</BasePath>
        <Properties/>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
