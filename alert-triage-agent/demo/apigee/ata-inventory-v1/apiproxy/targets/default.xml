<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="default">
    <Description>Target endpoint routing to ata-inventory-api Cloud Run</Description>
    <FaultRules/>
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <Flows/>
    <HTTPTargetConnection>
        <Authentication>
            <GoogleIDToken>
                <Audience useTargetUrl="true"/>
                <IncludeEmail>false</IncludeEmail>
            </GoogleIDToken>
        </Authentication>
        <LoadBalancer>
            <Server name="ata-inventory-target"/>
        </LoadBalancer>
        <Path>/</Path>
        <Properties>
            <Property name="connect.timeout.millis">5000</Property>
            <Property name="io.timeout.millis">5000</Property>
        </Properties>
    </HTTPTargetConnection>
</TargetEndpoint>
