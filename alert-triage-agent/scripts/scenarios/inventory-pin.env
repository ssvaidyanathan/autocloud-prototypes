# ata-inventory-api baseline pin: the ONE place the pinned revision and image digest live.
# Read by scripts/scenarios/common.sh (every scenario, reset and preflight) and by
# demo/ata-inventory-api/scripts/deploy.sh. KEY=VALUE lines only; anything else is an error.
#
# Do not edit by hand. Re-pin with scripts/repin-inventory.sh (DEPLOY.md, "Re-pinning
# ata-inventory-api"): `prepare` deploys and verifies a candidate revision with no traffic,
# `write-pin` rewrites this file (commit it), `switch` moves 100% of traffic to it.
#
# PIN_INVENTORY_PREVIOUS_*: the pin before this one, the rollback target. prune-revisions.sh
# never deletes it. Empty when there is no previous pin.
PIN_INVENTORY_REVISION=ata-inventory-api-00073-9vb
PIN_INVENTORY_DIGEST=sha256:24b07eaa50db6d226889607116f0dd43693df5e1f597867a79e0f86e3d7767ce
PIN_INVENTORY_PREVIOUS_REVISION=
PIN_INVENTORY_PREVIOUS_DIGEST=
