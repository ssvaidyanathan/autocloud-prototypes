# Prefix applied to all created resource names and labels (e.g. isa, acme)
name_prefix                          = "isa"
project_id                          = "your-project-id"
region                              = "us-central1"
environment                         = "production"
image_tag                           = "latest"
repository_id                       = "incident-bridge"
service_name                        = "incident-bridge"
bridge_service_account_id           = "bridge-sa"
tasks_queue_name                    = "isa-investigations"
tasks_invoker_service_account_email = "isa-tasks-invoker-sa@your-project-id.iam.gserviceaccount.com"
agent_service_url                   = "https://isa-sre-agent-xyz-uc.a.run.app"
agent_service_account_email         = "isa-agent-sa@your-project-id.iam.gserviceaccount.com"
callback_url                        = "https://isa-incident-bridge-xyz-uc.a.run.app/callback/report"
cloud_run_timeout_seconds           = 300
cloud_run_cpu                       = "1"
cloud_run_memory                    = "512Mi"
# Optional ticketing base URLs (can also be configured post-deploy)
servicenow_instance_url             = "https://your-instance.service-now.com"
jira_base_url                       = "https://your-domain.atlassian.net"

